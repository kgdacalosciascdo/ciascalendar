# Never commit .env.seed. It contains a Supabase service-role key.
SUPABASE_URL=https://your-existing-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Temporary password for newly created accounts. It defaults to cias2026 if omitted.
SEED_PASSWORD=cias2026
# Optional: comma-separated additional calendar administrator emails.
# Daphny Roa and Sherlyn Mae Lasacar are administrators by default.
SEED_ADMIN_EMAILS=
